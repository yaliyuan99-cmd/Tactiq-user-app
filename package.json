{
  "name": "tactiq-user-app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Tactiq user app \u2014 connect, calibrate, learn and practise the Tactiq ring's nine commands. Student research prototype; fully usable in Demo Mode without hardware.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite --port 5187 --strictPort",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "preview": "vite preview --port 5189 --strictPort",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:a11y": "playwright test e2e/accessibility.spec.ts",
    "test:e2e:install": "playwright install chromium",
    "check": "npm run lint && npm run typecheck && npm run test && npm run build"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.108.2",
    "lucide-react": "0.487.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router": "7.18.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.1",
    "@eslint/js": "^9.15.0",
    "@playwright/test": "1.62.1",
    "@tailwindcss/vite": "4.1.12",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^24.0.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "4.7.0",
    "eslint": "^9.15.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.14",
    "globals": "^15.12.0",
    "jsdom": "^25.0.1",
    "tailwindcss": "4.1.12",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.15.0",
    "vite": "6.4.5",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "vite": "6.4.5",
    "source-map-js": "^1.2.2",
    "eslint": {
      "brace-expansion": "^1.1.21"
    },
    "typescript-eslint": {
      "brace-expansion": "^5.0.12"
    }
  }
}
